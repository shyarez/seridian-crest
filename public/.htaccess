# ============================================================
# .htaccess — seridiancrest.com
# Overrides ResellerClub/Newfold host-injected parking pages
# and blocks mixed-content script injection from directfwd.com
# ============================================================

Options -Indexes
ServerSignature Off

# ------------------------------------------------------------
# Custom Error Documents
# Override host provider's 403/404 parking pages
# ------------------------------------------------------------
ErrorDocument 400 /403.html
ErrorDocument 401 /403.html
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html

# ============================================================
# RewriteEngine — must be ON before any RewriteRule/Cond
# ============================================================
RewriteEngine On

# ------------------------------------------------------------
# Force HTTPS — redirect all HTTP to HTTPS
# ------------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------
# Block directfwd.com / ResellerClub parking injection
# Match on Referer, query string, and URI path
# ------------------------------------------------------------

# Block if the request comes from directfwd.com
RewriteCond %{HTTP_REFERER} directfwd\.com [NC]
RewriteRule .* - [F,L]

# Block if query string references directfwd or _skz_ parking vars
RewriteCond %{QUERY_STRING} directfwd\.com [NC,OR]
RewriteCond %{QUERY_STRING} _skz_ [NC,OR]
RewriteCond %{QUERY_STRING} sk-jspark [NC]
RewriteRule .* - [F,L]

# Block requests to the parking script itself, by any path
RewriteCond %{REQUEST_URI} sk-jspark_init [NC,OR]
RewriteCond %{REQUEST_URI} jsinit [NC,OR]
RewriteCond %{REQUEST_URI} directfwd [NC,OR]
RewriteCond %{REQUEST_URI} parking [NC]
RewriteRule .* - [F,L]

# Block if User-Agent matches common parking/bot signatures
RewriteCond %{HTTP_USER_AGENT} (jsinit|directfwd|skz|jspark) [NC]
RewriteRule .* - [F,L]

# ------------------------------------------------------------
# Security Headers
# ------------------------------------------------------------
<IfModule mod_headers.c>
  # ── Content Security Policy ──────────────────────────────
  # - upgrade-insecure-requests: auto-upgrade http:// → https://
  # - default-src 'self' https:  — only allow HTTPS origins
  # - script-src: only self + your trusted CDNs; explicitly DENY directfwd
  # - object-src 'none': block Flash/plugins entirely
  Header always set Content-Security-Policy "\
upgrade-insecure-requests; \
default-src 'self' https:; \
script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; \
style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
font-src 'self' https://fonts.gstatic.com; \
img-src 'self' data: https://res.cloudinary.com https://images.unsplash.com https://placehold.co; \
connect-src 'self' https:; \
frame-ancestors 'none'; \
object-src 'none'; \
base-uri 'self'"

  # Prevent MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Prevent clickjacking
  Header always set X-Frame-Options "DENY"

  # XSS protection for legacy browsers
  Header always set X-XSS-Protection "1; mode=block"

  # HSTS — force HTTPS for 1 year, include subdomains, preload-ready
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Referrer policy — don't leak path on cross-origin requests
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy — disable sensors, camera, mic unless needed
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Remove host-fingerprinting headers
  Header always unset Server
  Header always unset X-Powered-By
  Header unset X-AspNet-Version
  Header unset X-AspNetMvc-Version
</IfModule>

# ------------------------------------------------------------
# Block parking script files by filename pattern
# ------------------------------------------------------------
<FilesMatch "(sk-jspark_init\.php|jsinit|directfwd|parking|_skz_)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------
# Block known ResellerClub/Newfold parking IP ranges
# (add more as identified via your server logs)
# ------------------------------------------------------------
# <RequireAll>
#   Require all granted
#   Require not ip 103.21.244.0/22
# </RequireAll>

# ------------------------------------------------------------
# Disable ETags (prevent server info leakage)
# ------------------------------------------------------------
FileETag None
Header unset ETag

# ------------------------------------------------------------
# Next.js Routing
# Handles both static export and Node.js adapter on cPanel
# ------------------------------------------------------------

# Serve real files and directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Next.js static export: serve pre-rendered HTML pages
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Fallback for client-side routing (SPA mode)
RewriteRule ^(.*)$ /index.html [L]
